<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Property Approved - SeasideHoliday</mj-title>
    <mj-preview>Congratulations! Your property is now live</mj-preview>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text padding="0" line-height="1.6" color="#1e293b" />
      <mj-button font-weight="600" border-radius="6px" inner-padding="12px 28px" />
      <mj-class name="heading-1" font-size="32px" font-weight="700" color="#0f172a" />
      <mj-class name="heading-2" font-size="20px" font-weight="600" color="#0f172a" />
      <mj-class name="body-text" font-size="14px" color="#475569" />
      <mj-class name="footer-text" font-size="12px" color="#94a3b8" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
    </mj-raw>
    <mj-style inline="inline">
      .dark-logo { display: none !important; }
    </mj-style>
    <mj-style>
      @media (prefers-color-scheme: dark) {
        .light-logo { display: none !important; }
        .dark-logo { display: block !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f8fafc">
    <!-- Header -->
    <mj-section padding="20px 0" background-color="#ffffff">
      <mj-column padding="20px">
        <mj-text mj-class="heading-2" color="#2563eb">
          SeasideHoliday
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#16a34a" padding="40px 20px">
      <mj-column padding="0">
        <mj-text mj-class="heading-1" color="#ffffff" align="center" padding="0 20px">
          ✓ Property Approved!
        </mj-text>
        <mj-text mj-class="body-text" color="#dcfce7" align="center" padding="12px 20px 0">
          Congratulations! Your property is live and ready to welcome guests
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Celebration -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#f0fdf4" border-left="4px solid #16a34a">
        <mj-text mj-class="heading-2" padding="0 0 12px" color="#15803d">
          🎉 Welcome to the SeasideHoliday Host Community!
        </mj-text>
        <mj-text mj-class="body-text" padding="0">
          Your property has been thoroughly reviewed and approved by our team. It is now visible to guests searching on SeasideHoliday and ready to receive bookings.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Property Details -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#ffffff">
        <mj-text mj-class="heading-2" padding="0 0 16px">
          Your Property
        </mj-text>

        <mj-text mj-class="body-text" padding="8px 0">
          <strong>Property Name:</strong><br />
          {{property_name}}
        </mj-text>

        <mj-text mj-class="body-text" padding="8px 0">
          <strong>Location:</strong><br />
          {{property_city}}, Bulgaria
        </mj-text>

        <mj-text mj-class="body-text" padding="8px 0">
          <strong>Property Type:</strong><br />
          {{property_type}}
        </mj-text>

        <mj-text mj-class="body-text" padding="8px 0">
          <strong>Capacity:</strong><br />
          Up to {{max_guests}} guests
        </mj-text>

        <mj-text mj-class="body-text" padding="16px 0 0" font-weight="600" color="#16a34a">
          Status: LIVE
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- What's Next -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#ffffff">
        <mj-text mj-class="heading-2" padding="0 0 12px">
          Getting Started
        </mj-text>

        <mj-text mj-class="body-text" padding="0">
          <strong>1. Review Your Listing</strong><br />
          Check your property page to ensure all information is correct and photos look great.
        </mj-text>

        <mj-text mj-class="body-text" padding="12px 0">
          <strong>2. Set Up Your Calendar</strong><br />
          Mark dates as available or unavailable to control your booking availability.
        </mj-text>

        <mj-text mj-class="body-text" padding="12px 0">
          <strong>3. Prepare for Guests</strong><br />
          Set house rules, check-in/check-out times, and response time preferences.
        </mj-text>

        <mj-text mj-class="body-text" padding="12px 0">
          <strong>4. Respond to Inquiries</strong><br />
          Reply promptly to booking requests to increase your approval rate.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Quick Stats -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#f8fafc">
        <mj-text mj-class="heading-2" padding="0 0 12px">
          Quick Stats
        </mj-text>

        <mj-table>
          <tr style="text-align: center; border-bottom: 1px solid #e2e8f0;">
            <td style="padding: 12px 8px; color: #0f172a; font-weight: 600;">Listing Quality</td>
            <td style="padding: 12px 8px; color: #15803d; font-weight: 600;">Premium</td>
          </tr>
          <tr style="text-align: center; border-bottom: 1px solid #e2e8f0;">
            <td style="padding: 12px 8px; color: #0f172a; font-weight: 600;">Visibility</td>
            <td style="padding: 12px 8px; color: #15803d; font-weight: 600;">Full</td>
          </tr>
          <tr style="text-align: center;">
            <td style="padding: 12px 8px; color: #0f172a; font-weight: 600;">Ready for Bookings</td>
            <td style="padding: 12px 8px; color: #15803d; font-weight: 600;">Yes ✓</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Resources -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#ffffff">
        <mj-text mj-class="heading-2" padding="0 0 12px">
          Helpful Resources
        </mj-text>
        <mj-text mj-class="body-text" padding="0">
          <a href="{{view_listing_url}}" style="color:#2563eb; text-decoration:none;">View Your Listing</a> • <a href="{{owner_dashboard_url}}" style="color:#2563eb; text-decoration:none;">Owner Dashboard</a>
        </mj-text>
        <mj-text mj-class="body-text" padding="8px 0 0">
          <a href="{{host_guide_url}}" style="color:#2563eb; text-decoration:none;">Host Guide</a> • <a href="{{best_practices_url}}" style="color:#2563eb; text-decoration:none;">Best Practices</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Buttons -->
    <mj-section padding="20px">
      <mj-column padding="0 10px">
        <mj-button href="{{view_listing_url}}" background-color="#16a34a" color="#ffffff" align="center" width="100%">
          View Your Listing
        </mj-button>
      </mj-column>
      <mj-column padding="0 10px">
        <mj-button href="{{owner_dashboard_url}}" background-color="#2563eb" color="#ffffff" align="center" width="100%">
          Go to Dashboard
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Tips -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#f1f5f9">
        <mj-text mj-class="heading-2" padding="0 0 12px" color="#1e293b">
          💡 Pro Tips for Success
        </mj-text>
        <mj-text mj-class="body-text" padding="0">
          • <strong>Respond within 12 hours</strong> to booking requests<br />
          • <strong>Keep photos updated</strong> to showcase your property<br />
          • <strong>Maintain house rules</strong> for guest safety and satisfaction<br />
          • <strong>Be professional</strong> in all guest communications
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Support -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#f8fafc">
        <mj-text mj-class="body-text" padding="0" color="#64748b">
          Have questions about hosting? Our support team is ready to help.
        </mj-text>
        <mj-text mj-class="footer-text" padding="8px 0 0" color="#94a3b8">
          <a href="mailto:support@brighter.bg" style="color:#2563eb; text-decoration:none;">support@brighter.bg</a> • <a href="{{help_url}}" style="color:#2563eb; text-decoration:none;">Help Center</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="20px 0" background-color="#ffffff" border-top="1px solid #e2e8f0">
      <mj-column padding="20px">
        <mj-text mj-class="footer-text" padding="0">
          © 2026 SeasideHoliday. All rights reserved.
        </mj-text>
        <mj-text mj-class="footer-text" padding="8px 0 0">
          <a href="{{unsubscribe_url}}" style="color:#2563eb; text-decoration:none;">Unsubscribe</a> • <a href="{{privacy_url}}" style="color:#2563eb; text-decoration:none;">Privacy Policy</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
