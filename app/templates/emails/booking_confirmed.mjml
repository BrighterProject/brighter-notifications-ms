<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Booking Confirmed - SeasideHoliday</mj-title>
    <mj-preview>Your booking is confirmed! Start planning your stay</mj-preview>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text padding="0" line-height="1.6" color="#1e293b" />
      <mj-button font-weight="600" border-radius="6px" inner-padding="12px 28px" />
      <mj-class name="heading-1" font-size="32px" font-weight="700" color="#0f172a" />
      <mj-class name="heading-2" font-size="20px" font-weight="600" color="#0f172a" />
      <mj-class name="body-text" font-size="14px" color="#475569" />
      <mj-class name="footer-text" font-size="12px" color="#94a3b8" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
    </mj-raw>
    <mj-style inline="inline">
      .dark-logo { display: none !important; }
      .success-badge { display: inline-block; background: #16a34a; color: white; padding: 8px 16px; border-radius: 24px; font-size: 12px; font-weight: 600; }
    </mj-style>
    <mj-style>
      @media (prefers-color-scheme: dark) {
        .light-logo { display: none !important; }
        .dark-logo { display: block !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f8fafc">
    <!-- Header -->
    <mj-section padding="20px 0" background-color="#ffffff">
      <mj-column padding="20px">
        <mj-text mj-class="heading-2" color="#2563eb">
          SeasideHoliday
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#16a34a" padding="40px 20px">
      <mj-column padding="0">
        <mj-text mj-class="heading-1" color="#ffffff" align="center" padding="0 20px">
          ✓ Booking Confirmed
        </mj-text>
        <mj-text mj-class="body-text" color="#dcfce7" align="center" padding="12px 20px 0">
          Great news! Your reservation is all set. We look forward to welcoming you.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Confirmation Details -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#ffffff">
        <mj-text mj-class="heading-2" padding="0 0 20px">
          Your Reservation
        </mj-text>

        <!-- Booking Reference -->
        <mj-text mj-class="body-text" padding="8px 0" color="#64748b">
          <strong>Confirmation Number:</strong><br />
          {{booking_id}}
        </mj-text>

        <!-- Property Details -->
        <mj-text mj-class="body-text" padding="12px 0">
          <strong>Property:</strong><br />
          {{property_name}}
        </mj-text>

        <!-- Dates -->
        <mj-text mj-class="body-text" padding="12px 0">
          <strong>Check-in:</strong><br />
          {{checkin_display}}
        </mj-text>

        <mj-text mj-class="body-text" padding="12px 0">
          <strong>Check-out:</strong><br />
          {{checkout_display}}
        </mj-text>

        <!-- Price Summary -->
        <mj-divider border-color="#e2e8f0" border-width="1px" padding="16px 0 12px" />

        <mj-text mj-class="body-text" padding="0" font-weight="600">
          {{currency}} {{total_price}} for {{num_nights}} nights
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- What to Expect -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#f0fdf4" border-left="4px solid #16a34a">
        <mj-text mj-class="heading-2" padding="0 0 12px" color="#15803d">
          What to Expect
        </mj-text>
        <mj-text mj-class="body-text" padding="0">
          <strong>Before Check-in:</strong> You'll receive a check-in code and property details 24 hours before arrival.
        </mj-text>
        <mj-text mj-class="body-text" padding="12px 0">
          <strong>House Rules:</strong> Please review the property's house rules and local guidelines.
        </mj-text>
        <mj-text mj-class="body-text" padding="12px 0">
          <strong>Support:</strong> Our team is available 24/7 if you have any questions.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Quick Links -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#ffffff">
        <mj-text mj-class="heading-2" padding="0 0 12px">
          Helpful Links
        </mj-text>
        <mj-text mj-class="body-text" padding="0">
          <a href="{{view_booking_url}}" style="color:#2563eb; text-decoration:none;">View Booking Details</a> • <a href="{{property_url}}" style="color:#2563eb; text-decoration:none;">Property Information</a>
        </mj-text>
        <mj-text mj-class="body-text" padding="8px 0 0">
          <a href="{{contact_owner_url}}" style="color:#2563eb; text-decoration:none;">Contact Property Owner</a> • <a href="{{house_rules_url}}" style="color:#2563eb; text-decoration:none;">House Rules</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Button -->
    <mj-section padding="20px">
      <mj-column>
        <mj-button href="{{view_booking_url}}" background-color="#16a34a" color="#ffffff" align="center" padding="16px">
          View Your Booking
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Support -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#f1f5f9">
        <mj-text mj-class="body-text" padding="0" color="#64748b">
          Have questions? Our support team is here 24/7.
        </mj-text>
        <mj-text mj-class="footer-text" padding="8px 0 0" color="#94a3b8">
          <a href="mailto:support@brighter.bg" style="color:#2563eb; text-decoration:none;">support@brighter.bg</a> • <a href="{{help_url}}" style="color:#2563eb; text-decoration:none;">Help Center</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="20px 0" background-color="#ffffff" border-top="1px solid #e2e8f0">
      <mj-column padding="20px">
        <mj-text mj-class="footer-text" padding="0">
          © 2026 SeasideHoliday. All rights reserved.
        </mj-text>
        <mj-text mj-class="footer-text" padding="8px 0 0">
          <a href="{{unsubscribe_url}}" style="color:#2563eb; text-decoration:none;">Unsubscribe</a> • <a href="{{privacy_url}}" style="color:#2563eb; text-decoration:none;">Privacy Policy</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
