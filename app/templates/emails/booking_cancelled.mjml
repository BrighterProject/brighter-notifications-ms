<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Booking Cancelled - Brighter</mj-title>
    <mj-preview>Your booking has been cancelled</mj-preview>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text padding="0" line-height="1.6" color="#1e293b" />
      <mj-button font-weight="600" border-radius="6px" inner-padding="12px 28px" />
      <mj-class name="heading-1" font-size="32px" font-weight="700" color="#0f172a" />
      <mj-class name="heading-2" font-size="20px" font-weight="600" color="#0f172a" />
      <mj-class name="body-text" font-size="14px" color="#475569" />
      <mj-class name="footer-text" font-size="12px" color="#94a3b8" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
    </mj-raw>
    <mj-style inline="inline">
      .dark-logo { display: none !important; }
    </mj-style>
    <mj-style>
      @media (prefers-color-scheme: dark) {
        .light-logo { display: none !important; }
        .dark-logo { display: block !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f8fafc">
    <!-- Header -->
    <mj-section padding="20px 0" background-color="#ffffff">
      <mj-column padding="20px">
        <mj-text mj-class="heading-2" color="#2563eb">
          Brighter
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#dc2626" padding="40px 20px">
      <mj-column padding="0">
        <mj-text mj-class="heading-1" color="#ffffff" align="center" padding="0 20px">
          Booking Cancelled
        </mj-text>
        <mj-text mj-class="body-text" color="#fee2e2" align="center" padding="12px 20px 0">
          Your booking has been cancelled as requested
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Cancellation Details -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#ffffff">
        <mj-text mj-class="heading-2" padding="0 0 16px">
          Cancellation Information
        </mj-text>

        <!-- Booking Reference -->
        <mj-text mj-class="body-text" padding="8px 0" color="#64748b">
          <strong>Booking ID:</strong><br />
          {{booking_id}}
        </mj-text>

        <!-- Property -->
        <mj-text mj-class="body-text" padding="12px 0">
          <strong>Property:</strong><br />
          {{property_name}}
        </mj-text>

        <!-- Original Dates -->
        <mj-text mj-class="body-text" padding="12px 0">
          <strong>Original Dates:</strong><br />
          {{start_date}} – {{end_date}}
        </mj-text>

        <!-- Cancellation Date -->
        <mj-text mj-class="body-text" padding="12px 0">
          <strong>Cancelled On:</strong><br />
          {{cancelled_date}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Refund Information -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#fef2f2" border-left="4px solid #dc2626">
        <mj-text mj-class="heading-2" padding="0 0 12px" color="#7f1d1d">
          Refund Status
        </mj-text>
        <mj-text mj-class="body-text" padding="0">
          <strong>Refund Amount:</strong> {{currency}} {{refund_amount}}
        </mj-text>
        <mj-text mj-class="body-text" padding="12px 0">
          <strong>Timeline:</strong> Refunds are typically processed within 5-7 business days. You'll receive a confirmation email when processed.
        </mj-text>
        <mj-text mj-class="body-text" padding="12px 0">
          <strong>Cancellation Policy:</strong> Your refund was processed according to the property's cancellation policy.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- What You Can Do -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#ffffff">
        <mj-text mj-class="heading-2" padding="0 0 12px">
          What Now?
        </mj-text>
        <mj-text mj-class="body-text" padding="0">
          We hope you'll consider Brighter for your future travel plans. Browse other properties that match your dates and budget.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Button -->
    <mj-section padding="20px">
      <mj-column>
        <mj-button href="{{browse_properties_url}}" background-color="#2563eb" color="#ffffff" align="center" padding="16px">
          Browse Other Properties
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Support -->
    <mj-section padding="20px">
      <mj-column padding="20px" background-color="#f1f5f9">
        <mj-text mj-class="body-text" padding="0" color="#64748b">
          If you have questions about this cancellation or your refund, please contact our support team.
        </mj-text>
        <mj-text mj-class="footer-text" padding="8px 0 0" color="#94a3b8">
          <a href="mailto:support@brighter.bg" style="color:#2563eb; text-decoration:none;">support@brighter.bg</a> • <a href="{{help_url}}" style="color:#2563eb; text-decoration:none;">Help Center</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="20px 0" background-color="#ffffff" border-top="1px solid #e2e8f0">
      <mj-column padding="20px">
        <mj-text mj-class="footer-text" padding="0">
          © 2026 Brighter.BG. All rights reserved.
        </mj-text>
        <mj-text mj-class="footer-text" padding="8px 0 0">
          <a href="{{unsubscribe_url}}" style="color:#2563eb; text-decoration:none;">Unsubscribe</a> • <a href="{{privacy_url}}" style="color:#2563eb; text-decoration:none;">Privacy Policy</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
